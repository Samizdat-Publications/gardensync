{
  "name": "gardensync",
  "version": "8.2.0",
  "private": true,
  "type": "module",
  "description": "Plan your beds square by square and get a sowing, planting and harvest schedule worked out for your own town.",
  "license": "MIT",
  "author": "Stewart Gregerson",
  "repository": "github:Samizdat-Publications/gardensync",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "shots": "playwright test --config playwright.shots.config.ts",
    "check": "node scripts/check.mjs",
    "deploy:preview": "node scripts/deploy.mjs preview",
    "deploy:production": "node scripts/deploy.mjs production"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@preact/signals": "^2.11.4",
    "immer": "^11.2.9",
    "preact": "^11.1.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "playwright": "1.64",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  }
}
